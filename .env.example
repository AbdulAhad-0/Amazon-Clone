# Vendra env — NAMES ONLY, empty placeholders. Never put real values in this file.
# Values live only in .env.local (git-ignored) and the Vercel dashboard.
#
# Supabase dashboard key mapping:
#   Settings -> API -> "publishable" (anon) key  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Settings -> API -> "secret" (service_role) key -> SUPABASE_SERVICE_ROLE_KEY  (server only)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Integration tests point at a SEPARATE Supabase test project (architecture section 10).
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
